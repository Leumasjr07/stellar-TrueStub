# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Workspace-specific ignores (Next.js build output, codegen, coverage, etc.)
# live in apps/frontend/.gitignore.

# dependencies (covers root + nested workspace node_modules)
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# rust / soroban contracts build output
**/target/
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
